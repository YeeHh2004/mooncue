name = "YeeHh2004/mooncue"

version = "0.2.0"

readme = "README.mbt.md"

repository = "https://github.com/YeeHh2004/mooncue"

license = "Apache-2.0"

keywords = [ "cue-sheet", "audio", "parser", "validation", "split-planning" ]

preferred_target = "wasm-gc"

description = "CUE sheet parser, validator and audio split planner, written in MoonBit"
